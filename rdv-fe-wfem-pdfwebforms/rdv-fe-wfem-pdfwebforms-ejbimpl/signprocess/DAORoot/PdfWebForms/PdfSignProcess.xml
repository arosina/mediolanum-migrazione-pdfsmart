<Access name="isAgenteClienteDiAltroAgente" type="DAOQueryAccess" queryType="0"
        connectionCacheReference="INR"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
	<Query>
		select case when A.AGE_C_AGE != C.AGE_C_AGE then 'S' else 'N' end 
		from INR_AGENTI A, INR_CODIFCLIMEDL C
		where A.CODIFCLIMEDL_C_CLI_MEDL = C.CODIFCLIMEDL_C_CLI_MEDL
		and A.AGE_C_AGE = ?
	</Query>
	<Input>
		<Parameter propertyName="codAgente"/>
	</Input>
</Access>

<Access name="getNdgFintoProspect" type="DAOQueryAccess" queryType="0" connectionCacheReference="DBAZ_SOGG"
		OutputCommandDataModel="com.atosorigin.wfem.types.StringType">
	<Query>
		select 	A.CLI_C as CODIFCLIMEDL_C_CLI_MEDL
		from 	CLL.V_CLI A 
		where 	A.CLI_X_CF = ?
		and		(A.CLI_F_SESSO in ('M','F') and (A.CLI_C_NATURA_GIURIDICA in ('FMM','FFF' ) or rtrim(ltrim(A.CLI_C_NATURA_GIURIDICA)) is null))
		and 	(A.BLOCCO_C_BLOCCO != 'R' OR A.BLOCCO_C_BLOCCO IS NULL)
	</Query>
	<Input>
		<Parameter propertyName="codFiscale"/>
	</Input>
</Access>

<Access name="hasSoggettoContiBancaDiretta" type="DAOQueryAccess" queryType="0" connectionCacheReference="DBAZ_SOGG"  
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
	<Query>
		select 	case when count(*) > 0 then 'S' else 'N' end
		from    CLL.CONTRCLI CONTRCLI
			    inner join CLL.CONTR CONTR
                        on CONTRCLI.CONTR_N = CONTR.CONTR_N and CONTRCLI.PROD_C = CONTR.PROD_C
                inner join CLL.TABDECOD_RETE TABRETE  
                        on TABRETE.COD_TIPO_DOM = 'CATEGORIA_CC' and TABRETE.COD_DOM = CONTR.CONTR_C_CAT					  
        WHERE 	CONTRCLI.CLI_C = ?       
        AND   	CONTRCLI.CONTRCLI_C_RUOLO_CONTR IN ('I', 'P', 'C')  
        AND   	CONTR.PROD_C = 'BAN01'
		AND     CONTR.CONTR_D_ESTI = to_date('31/12/9999','dd/mm/yyyy')
	</Query>
	<Input>
		<Parameter propertyName="ndg"/>
	</Input>	
</Access>

