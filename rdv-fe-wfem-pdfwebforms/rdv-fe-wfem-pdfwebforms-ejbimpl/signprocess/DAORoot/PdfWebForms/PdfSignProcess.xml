<Access name="loadTagMilestone" type="DAOQueryAccess" queryType="0" connectionCacheReference="SER_MIFID" maxResultRows="1">
 <Query>
	select  A.COD_TIPO_PROD_TMLN
	,       A.COD_TIPO_OPERAZ_TMLN
	,		(select tag.DES_TAG from SOGG_POSIZDISP.DETT_OPERZ_MILESTONE_TAG tag where tag.COD_TIPO_OPERAZ_TMLN=A.COD_TIPO_OPERAZ_TMLN and tag.PRG_TAG=1) as tag1
	,		(select tag.DES_TAG from SOGG_POSIZDISP.DETT_OPERZ_MILESTONE_TAG tag where tag.COD_TIPO_OPERAZ_TMLN=A.COD_TIPO_OPERAZ_TMLN and tag.PRG_TAG=2) as tag2
	from    SOGG_POSIZDISP.LEGM_TIPO_DISP_SIST_ORIG A
	where 	A.GSTD_F_ESIST = 'S'
	and		A.COD_TIPO_SIST_ORIG_DISP = 'PRT' 
	and		A.COD_TIPO_PROD_TMLN is not null
	and		A.COD_TIPO_OPERAZ_TMLN is not null
	and		A.COD_PROD_SIST_ORIG = ? 
	and 	A.COD_TIPO_OPERZ_PROD_SIST_ORIG = ?
 </Query> 
 <Input>
	<Parameter propertyName="pdfCodProdottoPrit"/>
	<Parameter propertyName="pdfCodOperazionePrit"/>
 </Input>
 <Output>
	<Parameter propertyName="pdfCodProdottoMilestone" propertyType="IntegerType"/>
	<Parameter propertyName="pdfCodOperazioneMilestone" propertyType="IntegerType"/>
	<Parameter propertyName="tag1" propertyType="StringType"/>
	<Parameter propertyName="tag2" propertyType="StringType"/>
 </Output>
</Access> 

