<Access name="loadCellulareAnagEffettivo" type="DAOQueryAccess" queryType="0" connectionCacheReference="DBAZ_SOGG">
	<Query>
		select  RECAPTELCLI_X_PREF_TEL,  
				RECAPTELCLI_X_NUM_TEL
		from 	CLL.V_RECAPTELCLI
		where 	ASSGNCLIAGE_C_POTZLE = ?
		and		TIPRECAPTEL_C_TIP_RECAP = '14'
	</Query>
	<Input>
		<Parameter propertyName="codPotenziale"/>
	</Input>
	<Output>
		<Parameter propertyName="signData_prefissoCellulareAnag"/>
		<Parameter propertyName="signData_numeroCellulareAnag"/>
	</Output>
</Access>

<Access name="loadCellulareAnagCensito" type="DAOQueryAccess" queryType="0" connectionCacheReference="DBAZ_SOGG">
	<Query>
		select 	'C', 
				RECAPTELCLI_X_PREF_TEL || RECAPTELCLI_X_NUM_TEL,
				RECAPTELCLI_X_PREF_TEL,  
				RECAPTELCLI_X_NUM_TEL
		from 	cll.INR_RECAPTELCLI_ELETTR_REP
		where 	ASSGNCLIAGE_C_POTZLE = ?
		and		TIPRECAPTEL_C_TIP_RECAP = '14'
	</Query>
	<Input>
		<Parameter propertyName="idCensimento"/>
	</Input>
	<Output>
		<Parameter propertyName="signData_statoCelluarePrimario"/>
		<Parameter propertyName="signData_numeroCelluarePrimario"/>
		<Parameter propertyName="signData_prefissoCellulareAnag"/>
		<Parameter propertyName="signData_numeroCellulareAnag"/>
	</Output>
</Access>

