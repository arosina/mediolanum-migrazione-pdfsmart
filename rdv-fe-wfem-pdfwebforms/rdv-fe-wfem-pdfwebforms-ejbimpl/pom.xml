<?xml version="1.0" encoding="ISO-8859-15"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>prgm.pdfwebforms.backend</groupId>
    <artifactId>rdv-fe-wfem-pdfwebforms</artifactId>
    <version>9.0.0-RC-SNAPSHOT</version>
  </parent>
  <artifactId>rdv-fe-wfem-pdfwebforms-ejbimpl</artifactId>
  <name>PdfWebForms</name>
  <properties>
    <sonar.tests>${project.basedir}/test</sonar.tests>
    <sonar.sources>${project.basedir}/src,${project.basedir}/sendprocess,${project.basedir}/signprocess,${project.basedir}/copernicoprocess,${project.basedir}/sostituzioni,${project.basedir}/mom,${project.basedir}/dataloader,${project.basedir}/publisher,${project.basedir}/messagecodesupdater</sonar.sources>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.atosorigin.wfem</groupId>
      <artifactId>rdv-be-wfem-framework-ejbimpl</artifactId>
      <version>22.0.0-RC-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>prgm.itap.dac</groupId>
      <artifactId>rdv-fe-wfem-itapdac-ejbimpl</artifactId>
      <version>${dep.rdv-fe-wfem-itapdac-ejbimpl.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/agevolazioni</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/mom</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/carrello</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/reportadeguatezza</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
