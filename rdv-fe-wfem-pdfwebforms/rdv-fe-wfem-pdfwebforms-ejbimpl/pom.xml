          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/messagecodesupdater</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/aml</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/src</source>
                <source>${project.basedir}/agevolazioni</source>
                <source>${project.basedir}/mom</source>
                <source>${project.basedir}/carrello</source>
                <source>${project.basedir}/reportadeguatezza</source>
                <source>${project.basedir}/jsonsrv</source>
                <source>${project.basedir}/mifid</source>
                <source>${project.basedir}/copernicoprocess</source>
                <source>${project.basedir}/dataentryutil</source>
                <source>${project.basedir}/catalog</source>
                <source>${project.basedir}/sendprocess</source>
                <source>${project.basedir}/signprocess</source>
                <source>${project.basedir}/dataloader</source>
                <source>${project.basedir}/publisher</source>
                <source>${project.basedir}/idd</source>
			    <source>${project.basedir}/sostituzioni</source>
			    <source>${project.basedir}/messagecodesupdater</source>
			    <source>${project.basedir}/aml</source>
              </sources>
            </configuration>
          </execution>
			<execution>
				<id>add-test-source</id>
				<phase>generate-test-sources</phase>
				<goals>
					<goal>add-test-source</goal>
				</goals>
				<configuration>
					<sources>
						<source>${project.basedir}/test</source>
					</sources>
				</configuration>
			</execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <phase>prepare-package</phase>
          </execution>
        </executions>
      </plugin>
	  <plugin>
		<groupId>org.jacoco</groupId>
		<artifactId>jacoco-maven-plugin</artifactId>
	  </plugin>
	  <plugin>
		<groupId>org.codehaus.mojo</groupId>
		<artifactId>truezip-maven-plugin</artifactId>
	   </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>copyjar</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
