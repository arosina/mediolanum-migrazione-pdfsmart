<Access name="pdfPubblicationList" type="DAOQueryAccess" queryType="0"
		OutputCommandDataModel="prgm.pdfwebforms.publisher.model.PdfAnagModel">
 <Query>
	select 	A.PDF_ID
	,		A.CODE
	, 		P.PUBLICATION_ID
	,		P.EDITION
	,		P.ACROFORM_VERSION
	,		P.DRIVER_VERSION
	,		P.MOM_VERSION
	, 		P.START_DATE
	,		P.DATA_FINE_ACCET_PUBBL_PREC
	,		P.FILE_NAME
	,		(select count(PG.PDF_ID) from PDF_PAGE PG where PG.PDF_ID = P.PDF_ID and PG.PUBLICATION_ID = P.PUBLICATION_ID) as pdfNumPages	
	,		(select P2.PUBLICATION_ID from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = P.PDF_ID and P2.START_DATE &lt;= getdate() having P2.START_DATE = max(P2.START_DATE) and P2.PUBLISH_TIME = max(P2.PUBLISH_TIME)) as pdfPubIdCorrente
	,		case when datalength(P.PUBLICATION_NOTES) > 0 then 'S' else 'N' end as pdfHasPublicationNotes	
	,		case when datalength(P.VALIDATION_WARNINGS_MSG) > 0 then 'S' else 'N' end pdfHasValidationWarningMessage
	from 	PDF_ANAG A, PDF_PUBLICATION P
	where	A.PDF_ID = ?
	and		A.PDF_ID = P.PDF_ID
	and		(P.IS_ARCHIVED is null or P.IS_ARCHIVED = 'N')
	order by convert(varchar(8),P.START_DATE,112) desc, P.PUBLICATION_ID desc
 </Query> 
 <Input>
	<Parameter propertyName="pdfId"/>
 </Input>
 <Output>
	<Parameter propertyName="pdfId"/>
	<Parameter propertyName="pdfCode"/>
	<Parameter propertyName="pdfPublicationId"/>
	<Parameter propertyName="pdfEdition"/>
	<Parameter propertyName="pdfAcroformVersion"/>
	<Parameter propertyName="pdfDriverVersion"/>
	<Parameter propertyName="pdfMomVersion"/>
	<Parameter propertyName="pdfPubStartDate"/>
	<Parameter propertyName="pdfDataFineAccettazionePubblPrec"/>
	<Parameter propertyName="pdfFileName"/>
	<Parameter propertyName="pdfNumPages"/>
	<Parameter propertyName="pdfPubIdCorrente"/>
	<Parameter propertyName="pdfHasPublicationNotes"/>
	<Parameter propertyName="pdfHasValidationWarningMessage"/>
 </Output> 
</Access> 

