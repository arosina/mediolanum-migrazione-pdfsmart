<Access name="loadOtherPdfData" type="DAOQueryAccess" queryType="1">
 <Query>
	select 	(select count (*) from PDF_PAGE PG where PG.PDF_ID = P.PDF_ID and PG.PUBLICATION_ID = P.PUBLICATION_ID) as pdfNumPages
	,		(select P2.PUBLICATION_ID from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = P.PDF_ID and P2.START_DATE &lt;= getdate() having P2.START_DATE = max(P2.START_DATE) and P2.PUBLISH_TIME = max(P2.PUBLISH_TIME)) as pdfPubIdCorrente	
	,		(select count (*) from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = P.PDF_ID) as pdfNumPubblicazioni
	from 	PDF_PUBLICATION P
	where	P.PDF_ID = <p>pdfId</p>
	and		P.PUBLICATION_ID = <p>pdfPublicationId</p>
 </Query> 
 <Output>
	<Parameter propertyName="pdfNumPages"/>
	<Parameter propertyName="pdfPubIdCorrente"/>
	<Parameter propertyName="pdfNumPubblicazioni"/>
 </Output> 
</Access> 
<Access name="loadOtherPdfDataOnWork" type="DAOQueryAccess" queryType="1">
