<DAO-Object name="PdfPublisher" connectionCacheReference="CEPE">

<CodDescriptions>

   	<CodDesc name="Aree" tableName="PDF_AREAS" codColumnName="AREA" descrColumnName="DESCR"/>
   
	<CodDesc name="ProdottiPrit" tableName="CEPE_PT_RETEP_PRODOTTO" refreshTime="120" connectionCacheReference="CEPE"
			 codColumnName="PT_PRODOTTO_N_PT_PRODOTTO" 
			 descrColumnName="PT_PRODOTTO_X_PT_PRODOTTO + '  [cod. ' + convert(varchar(20),PT_PRODOTTO_N_PT_PRODOTTO) + ']'" descrAliasColumnName="DESCR"  
			 whereCondition="PT_PRODOTTO_N_PT_PRODOTTO != 0"
			 validityWhereCondition="PT_PRODOTTO_N_PT_PRODOTTO != 0 and PT_PRODOTTO_F_VALIDITA = 'S'"
			 orderBy="upper(PT_PRODOTTO_X_PT_PRODOTTO)"/>

	<CodDesc name="OperazioniProdottoPrit" tableName="CEPE_PT_RETEP_OPERAZIONE O, CEPE_PT_RETEP_PRODOPER PO" connectionCacheReference="CEPE"
			 codColumnName="O.PT_OPERAZIONE_N_PT_OPERAZIONE" 
			 descrColumnName="O.PT_OPERAZIONE_X_PT_OPERAZIONE + '  [cod. ' + convert(varchar(20),O.PT_OPERAZIONE_N_PT_OPERAZIONE) + ']'" descrAliasColumnName="DESCR"
			 whereCondition="PO.PT_PRODOTTO_N_PT_PRODOTTO = ? and O.PT_OPERAZIONE_N_PT_OPERAZIONE != 0 and PO.PT_OPERAZIONE_N_PT_OPERAZIONE = O.PT_OPERAZIONE_N_PT_OPERAZIONE"
			 validityWhereCondition="PO.PT_PRODOTTO_N_PT_PRODOTTO = ? and O.PT_OPERAZIONE_N_PT_OPERAZIONE != 0 and PO.PT_OPERAZIONE_N_PT_OPERAZIONE = O.PT_OPERAZIONE_N_PT_OPERAZIONE and O.PT_OPERAZIONE_F_VALIDITA = 'S' and (PO.PT_PRODOPER_F_VALIDITA is null or PO.PT_PRODOPER_F_VALIDITA = 'S')"
			 orderBy="upper(O.PT_OPERAZIONE_X_PT_OPERAZIONE)">
	     <WhereFields>
	        <Parameter propertyName="pdfCodProdottoPrit"/>
	     </WhereFields>
	     <ValidityFields>
	        <Parameter propertyName="pdfCodProdottoPrit"/>
	     </ValidityFields>
     </CodDesc>
     
   	<CodDesc name="LineeBusiness" tableName="PDF_LINEE_DI_BUSINESS" codColumnName="CODICE" descrColumnName="DESCRIZIONE" orderBy="ORDINE"/>
   	<CodDesc name="FasiCommerciali" tableName="PDF_FASI_COMMERCIALI" codColumnName="CODICE" descrColumnName="DESCRIZIONE" orderBy="ORDINE"/>
   	
</CodDescriptions>

<Access name="searchPdfAnagCatalogo" type="DAOQueryAccess" queryType="1" maxResultRows="100"
		OutputCommandDataModel="prgm.pdfwebforms.publisher.model.PdfAnagModel">
 <Query>
	select 	distinct 
			C.ID_MODULO as pdfId
	,		C.CODICE_MODULO as pdfCode
	, 		C.DESCRIZIONE as pdfDescr
	,		C.VALIDO_DAL
	,		C.VALIDO_FINO_AL  
	,		(select P2.PUBLICATION_ID from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = C.ID_MODULO and P2.START_DATE &lt;= getdate() having P2.START_DATE = max(P2.START_DATE) and P2.PUBLISH_TIME = max(P2.PUBLISH_TIME)) as pdfPubIdCorrente	
	, 		(select count(P2.PDF_ID) from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = C.ID_MODULO) as pdfNumPubblicazioni
	, 		(select count(P2.PDF_ID) from PDF_PUBLICATION P2 where P2.IS_ARCHIVED = 'S' and P2.PDF_ID = C.ID_MODULO) as pdfNumArchiviazioni
	,		'S' as isFromCatalogoModuli
	,		(select case when (select count(*) from PDF_ANAG A where A.PDF_ID = C.ID_MODULO) = 0 then 'N' else 'S' end) as isOnWork
	,		(select DESCR from PDF_AREAS where AREA='CATALOGO_MODULI') as pdfArea
	,		(select AA.MOM_CODE from PDF_ANAG AA where AA.PDF_ID = C.ID_MODULO) as pdfMomCode
	,		(select AA.COD_PRODOTTO_PRIT from PDF_ANAG AA where AA.PDF_ID = C.ID_MODULO) as pdfCodProdottoPrit
	,		(select AA.COD_OPERAZIONE_PRIT from PDF_ANAG AA where AA.PDF_ID = C.ID_MODULO) as pdfCodOperazionePrit
	,		(select AA.CALL_SRV_DISPOSITIVA_BMED from PDF_ANAG AA where AA.PDF_ID = C.ID_MODULO) as callSrvDispositivaBMED
	,		(select AA.TIPO_PROCESSO_SEDE from PDF_ANAG AA where AA.PDF_ID = C.ID_MODULO) as tipoProcessoSede
	from 	CEPE_CATM_MODULO C
	<IfEqual propertyName="isRicercaOnAnag" propertyValue="true">, PDF_ANAG A</IfEqual>
	where 	ltrim(rtrim(C.CODICE_MODULO)) is not null
	<IfEqual propertyName="isRicercaOnAnag" propertyValue="true">and C.ID_MODULO = A.PDF_ID</IfEqual>
	<IfNotNull propertyName="ricercaPdfParam_pdfCode">and upper(C.CODICE_MODULO) like upper(<p>%ricercaPdfParam_pdfCode%</p>)</IfNotNull>
	<IfNotNull propertyName="ricercaPdfParam_pdfDescr">and upper(C.DESCRIZIONE) like upper(<p>%ricercaPdfParam_pdfDescr%</p>)</IfNotNull>
	<IfEqual propertyName="soloAttivi" propertyValue="true">and (getdate() between C.VALIDO_DAL and isnull(dateadd(dd,+1,C.VALIDO_FINO_AL),'99990101'))</IfEqual>
	
	<IfEqual propertyName="isRicercaOnAnag" propertyValue="true">
		<IfNotNull propertyName="ricercaPdfParam_pdfMomCode">and upper(A.MOM_CODE) = upper(<p>ricercaPdfParam_pdfMomCode</p>)</IfNotNull>
		<IfNotNull propertyName="ricercaPdfParam_callSrvDispositivaBMED">
			<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="ISNULL">and A.CALL_SRV_DISPOSITIVA_BMED is null</IfEqual>
			<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="D">and A.CALL_SRV_DISPOSITIVA_BMED = 'D'</IfEqual>
			<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="S">and A.CALL_SRV_DISPOSITIVA_BMED = 'S'</IfEqual>
		</IfNotNull>
	</IfEqual>
	order by 3 desc
 </Query> 
 <Output>
	<Parameter propertyName="pdfId"/>
	<Parameter propertyName="pdfCode"/>
	<Parameter propertyName="pdfDescr"/>
	<Parameter propertyName="pdfStartDate"/>
	<Parameter propertyName="pdfEndDate"/>
	<Parameter propertyName="pdfPubIdCorrente"/>
	<Parameter propertyName="pdfNumPubblicazioni"/>
	<Parameter propertyName="pdfNumArchiviazioni"/>
	<Parameter propertyName="isFromCatalogoModuli"/>
	<Parameter propertyName="isOnWork"/>
	<Parameter propertyName="pdfArea"/>
	<Parameter propertyName="pdfMomCode"/>
	<Parameter propertyName="pdfCodProdottoPrit"/>
	<Parameter propertyName="pdfCodOperazionePrit"/>
	<Parameter propertyName="callSrvDispositivaBMED"/>
	<Parameter propertyName="tipoProcessoSede"/>
 </Output> 
</Access> 

<Access name="searchPdfAnag" type="DAOQueryAccess" queryType="1" maxResultRows="100"
		OutputCommandDataModel="prgm.pdfwebforms.publisher.model.PdfAnagModel">
 <Query>
	select 	distinct 
			A.PDF_ID as pdfId
	,		A.CODE as pdfCode
	, 		A.DESCR as pdfDescr
	,		A.START_DATE
	,		A.END_DATE
	,		(select P2.PUBLICATION_ID from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = A.PDF_ID and P2.START_DATE &lt;= getdate() having P2.START_DATE = max(P2.START_DATE) and P2.PUBLISH_TIME = max(P2.PUBLISH_TIME)) as pdfPubIdCorrente	
	, 		(select count(P2.PDF_ID) from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = A.PDF_ID) as pdfNumPubblicazioni
	, 		(select count(P2.PDF_ID) from PDF_PUBLICATION P2 where P2.IS_ARCHIVED = 'S' and P2.PDF_ID = A.PDF_ID) as pdfNumArchiviazioni
	,		'N' as isFromCatalogoModuli
	,		'S' as isOnWork
	,		isnull((select AR.DESCR from PDF_AREAS AR where AR.AREA=A.AREA),A.AREA) as pdfArea
	,		A.MOM_CODE as pdfMomCode
	,		A.COD_PRODOTTO_PRIT as pdfCodProdottoPrit
	,		A.COD_OPERAZIONE_PRIT as pdfCodOperazionePrit
	,		A.CALL_SRV_DISPOSITIVA_BMED as callSrvDispositivaBMED
	,		A.TIPO_PROCESSO_SEDE as tipoProcessoSede
	from 	PDF_ANAG A
	where 	1 = 1
	<IfNotNull propertyName="area">and A.AREA = <p>area</p></IfNotNull>
	<IfNotNull propertyName="ricercaPdfParam_pdfCode">and upper(A.CODE) like upper(<p>%ricercaPdfParam_pdfCode%</p>)</IfNotNull>
	<IfNotNull propertyName="ricercaPdfParam_pdfMomCode">and upper(A.MOM_CODE) = upper(<p>ricercaPdfParam_pdfMomCode</p>)</IfNotNull>
	<IfNotNull propertyName="ricercaPdfParam_pdfDescr">and upper(A.DESCR) like upper(<p>%ricercaPdfParam_pdfDescr%</p>)</IfNotNull>
	<IfNotNull propertyName="ricercaPdfParam_pdfDriverName">and A.DRIVER_NAME like <p>%ricercaPdfParam_pdfDriverName%</p></IfNotNull>
	<IfEqual propertyName="soloAttivi" propertyValue="true">
		and (A.START_DATE is null or A.START_DATE &lt;= getDate())
		and (A.END_DATE is null or dateadd(dd,+1,A.END_DATE) &gt;= getDate())
	</IfEqual>
	<IfNotNull propertyName="ricercaPdfParam_callSrvDispositivaBMED">
		<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="ISNULL">and A.CALL_SRV_DISPOSITIVA_BMED is null</IfEqual>
		<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="D">and A.CALL_SRV_DISPOSITIVA_BMED = 'D'</IfEqual>
		<IfEqual propertyName="ricercaPdfParam_callSrvDispositivaBMED" propertyValue="S">and A.CALL_SRV_DISPOSITIVA_BMED = 'S'</IfEqual>
	</IfNotNull>
	order by 3 desc
 </Query> 
 <Output>
	<Parameter propertyName="pdfId"/>
	<Parameter propertyName="pdfCode"/>
	<Parameter propertyName="pdfDescr"/>
	<Parameter propertyName="pdfStartDate"/>
	<Parameter propertyName="pdfEndDate"/>
	<Parameter propertyName="pdfPubIdCorrente"/>
	<Parameter propertyName="pdfNumPubblicazioni"/>
	<Parameter propertyName="pdfNumArchiviazioni"/>
	<Parameter propertyName="isFromCatalogoModuli"/>
	<Parameter propertyName="isOnWork"/>
	<Parameter propertyName="pdfArea"/>
	<Parameter propertyName="pdfMomCode"/>
	<Parameter propertyName="pdfCodProdottoPrit"/>
	<Parameter propertyName="pdfCodOperazionePrit"/>
	<Parameter propertyName="callSrvDispositivaBMED"/>
	<Parameter propertyName="tipoProcessoSede"/>
 </Output> 
</Access> 

<Access name="pdfCodeExist" type="DAOQueryAccess" queryType="0"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
 <Query>
	select case when ((select count(*) from PDF_ANAG where CODE = ?) + 
					  (select count(*) from CEPE_CATM_MODULO where CODICE_MODULO = ?)
					  ) > 0 then 'S' else 'N' end as pdfCodeExist  
 </Query> 
 <Input>
	<Parameter propertyName="pdfCode"/>
	<Parameter propertyName="pdfCode"/>
 </Input> 
</Access> 

<Access name="pdfMomCodeExist" type="DAOQueryAccess" queryType="1"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
 <Query>
	select case when 
		(select count(*) from PDF_ANAG where MOM_CODE = <p>pdfMomCode</p> and AREA = <p>pdfArea</p> <IfNotNull propertyName="pdfId">and PDF_ID != <p>pdfId</p></IfNotNull>) > 0 
		then 'S' else 'N' end as pdfMomCodeExist  
 </Query> 
</Access> 

<Access name="loadModuloCatalogoAnag" type="DAOQueryAccess" queryType="0" maxResultRows="1">
 <Query>
	select 	top 1
			C.CODICE_MODULO
	,		C.DESCRIZIONE
	,		isnull(TM.DESCRIZIONE,convert(varchar,C.CODICE_TIPOMODULO))
	,		isnull(TS.DESCRIZIONE,convert(varchar,C.CODICE_SEGMENTO))
	,		C.VALIDO_DAL
	,		C.VALIDO_FINO_AL
	,		C.FLAG_CONTR_ELETTR
	,		C.FLAG_STAMPA_CONTR_ELETTR
	,		C.FLAG_INTRANET
	,		C.FLAG_CARTA_CHIMICA
	,		(select P2.START_DATE from PDF_PUBLICATION P2 where (P2.IS_ARCHIVED is null or P2.IS_ARCHIVED = 'N') and P2.PDF_ID = C.ID_MODULO and P2.START_DATE &lt;= getdate() having P2.START_DATE = max(P2.START_DATE) and P2.PUBLISH_TIME = max(P2.PUBLISH_TIME)) as dataUltimaPubblicazione 
	from 	CEPE_CATM_MODULO C, CEPE_CATM_TIPOMODULO TM, CEPE_CATM_SEGMENTO TS, PDF_ANAG PA
	where 	C.ID_MODULO = ?
	and		C.CODICE_TIPOMODULO *= TM.CODICE_TIPOMODULO
	and		C.CODICE_SEGMENTO *= TS.CODICE_SEGMENTO
	and		C.ID_MODULO *= PA.PDF_ID
	and		PA.AREA = 'CATALOGO_MODULI'
 </Query>
 <Input>
	<Parameter propertyName="pdfId"/>
 </Input> 
 <Output>
 	<Parameter propertyName="pdfCode"/>
 	<Parameter propertyName="pdfDescr"/>
	<Parameter propertyName="pdfModulo_tipoModulo"/>
	<Parameter propertyName="pdfModulo_segmento"/>
	<Parameter propertyName="pdfModulo_dataInizioValidita"/>
	<Parameter propertyName="pdfModulo_dataFineValidita"/>
	<Parameter propertyName="pdfModulo_flagContrElettronico"/>
	<Parameter propertyName="pdfModulo_flagStampaContrElettronico"/>
	<Parameter propertyName="pdfModulo_flagIntranet"/>
	<Parameter propertyName="pdfModulo_flagCartaChimica"/>
	<Parameter propertyName="pdfModulo_dataUltimaPubblicazione"/>	
 </Output> 
</Access> 

