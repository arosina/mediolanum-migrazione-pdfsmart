<Access name="isCodiceAgevolazioneGiaUtilizzato" type="DAOQueryAccess" queryType="1"  connectionCacheReference="CEPE"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
	<Query>
		select 	case when count(*) = 0 then 'N' else 'S' end 
		from 	PDF_INSTANCE
		where 	ID_AGEVOLAZIONE = <p>idAgevolazione</p>
		and 	<c>prgm.pdfwebforms.model.PdfInstanceModel.CONDIZIONE_STATO_PDF_COMPLETATO_RETE</c>
 	</Query> 
</Access>

<Access name="isCodiceAgevolazioneBruciato" type="DAOQueryAccess" queryType="0"  connectionCacheReference="CEPE"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
