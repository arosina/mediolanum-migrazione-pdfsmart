		select 	case when count(*) = 0 then 'N' else 'S' end 
		from 	CEPE_CRLEVE_MOV_DEROG_GEST ag, CEPE_CRLEVE_LOGATTIVITA log
		where 	ag.ID_DEROGA = convert(numeric,?)
