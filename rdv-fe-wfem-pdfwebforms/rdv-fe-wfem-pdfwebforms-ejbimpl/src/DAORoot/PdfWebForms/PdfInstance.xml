<Access name="loadBatchQueueFlags" type="DAOQueryAccess" queryType="0" maxResultRows="1">
 <Query>
	select 	ON_SIGNED_PROC_QUEUE
	,		ON_POSTCOMPL_PROC_QUEUE
	from 	PDF_INSTANCE
	where 	PDF_INSTANCE_ID = ?
 </Query> 
 <Input>
	<Parameter propertyName="pdfInstanceId"/>
 </Input>
 <Output>
	<Parameter propertyName="putOnSignedProcessBatchQueue"/>
	<Parameter propertyName="putOnPostCompletionProcessBatchQueue"/>
 </Output>
</Access> 

<Access name="loadPdfInstanceContent" type="DAOQueryAccess" queryType="0" maxResultRows="1">
 <Query>
	select 	top 1 I.PDF_CONTENT
	, 		I.CODE
	, 		(select P.EDITION from PDF_PUBLICATION P where P.PDF_ID=I.PDF_ID and P.PUBLICATION_ID=I.PUBLICATION_ID) as pdfEdition
	from 	PDF_INSTANCE I
	where 	I.PDF_INSTANCE_ID = ?
 </Query> 
 <Input>
	<Parameter propertyName="pdfInstanceId"/>
 </Input> 
 <Output>
	<Parameter propertyName="pdfContent"/>
	<Parameter propertyName="pdfAnag_pdfCode"/>
	<Parameter propertyName="pdfAnag_pdfEdition"/>
 </Output>
</Access>

