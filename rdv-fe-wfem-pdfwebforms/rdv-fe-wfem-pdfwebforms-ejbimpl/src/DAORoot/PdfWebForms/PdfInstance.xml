<Access name="loadPdfAnagData" type="DAOQueryAccess" queryType="1" maxResultRows="1">
 <Query>
	select 	top 1
			P.EDITION
	,		A.MOM_CODE
	,		P.ACROFORM_VERSION
	,		P.DRIVER_VERSION
	,		P.MOM_VERSION
	,		A.DESCR
	,		A.COD_PRODOTTO_PRIT
	,		A.COD_OPERAZIONE_PRIT
	,		A.IS_STAMPA_ENABLED
	,		A.IS_CARTA_LIBERA_ENABLED
	,		A.IS_CARTA_CHIMICA_ENABLED
	,		A.IS_FIRMA_DIGTALE_ENABLED
	,		A.IS_COPERNICO_ENABLED
	,		A.NUM_COPIE
	,		A.TESTO_COPIA_1
	,		A.TESTO_COPIA_2
	,		A.TESTO_COPIA_3
	,		A.TESTO_COPIA_4
	,		(select count(PG.PDF_ID) from PDF_PAGE<IfEqual propertyName="isOnWork" propertyValue="true">_WORK</IfEqual> PG 
			 where PG.PDF_ID = <p>pdfId</p> <IfEqual propertyName="isOnWork" propertyValue="false">and PG.PUBLICATION_ID = <p>pdfPublicationId</p></IfEqual>) as pdfNumPages
	,		null as pdfCompilationExampleFileType
	,		A.DRIVER_NAME
	,		A.SIGN_ALL
	,		A.EXT_LINK_ONSIGN_LABEL
	,		A.EXT_LINK_ONSIGN_URL
	,		A.EXT_LINK_AGG_ONSIGN_LABEL
	,		A.EXT_LINK_AGG_ONSIGN_URL
	,		A.IS_PROSPECT_ENABLED_ON_CLI1
	,		A.IS_PROSPECT_ENABLED_ON_CLI2
	,		A.IS_PROSPECT_ENABLED_ON_CLI3
	,		A.IS_PROSPECT_ENABLED_ON_CLI4
	,		A.IS_PROSPECT_ENABLED_ON_CLI5
	,		A.IS_PROSPECT_ENABLED_ON_CLI6
	,		A.IS_PROSPECT_ENABLED_ON_CLI7
	,		A.IS_PROSPECT_ENABLED_ON_CLI8
	,		A.IS_PROSPECT_ENABLED_ON_CLI9
	,		A.IS_CONTROLLI_COMPLETI
	,		A.AREA
	,		A.HAS_PRIIPS
	,		A.FAC_SIMILE_ON_PREVIEW
	,		A.CALL_SRV_DISPOSITIVA_BMED
	,		A.TIPO_PROCESSO_SEDE
	,		A.TIPO_PROCESSO_SEDE
	,		A.HAS_DATA_SOTTOSCRIZIONE_OGGI
	,		A.NOTE_FB_COPERNICO
	,		A.COD_LINEA_BUSINESS
	,		A.COD_FASE_COMMERCIALE
	,		A.HAS_PREFERENZE_IN_PRIIPS
	,		A.ON_STOCK_PROC_QUEUE
	,		HAS_CONTROLLO_AML_AVR
	,		HAS_CONTROLLO_AML_PEP
	,		HAS_CONTROLLO_SCAI
	,		HAS_LAYER_COLLOC_A_DISTANZA
	,		A.SOCIETA
	from 	PDF_ANAG A, PDF_PUBLICATION<IfEqual propertyName="isOnWork" propertyValue="true">_WORK</IfEqual> P 
	where 	A.PDF_ID = P.PDF_ID
	and		P.PDF_ID = <p>pdfId</p>
	<IfEqual propertyName="isOnWork" propertyValue="false">and P.PUBLICATION_ID = <p>pdfPublicationId</p></IfEqual> 
 </Query> 
 <Output>
	<Parameter propertyName="pdfEdition"/>
	<Parameter propertyName="pdfMomCode"/>
	<Parameter propertyName="pdfAcroformVersion"/>
	<Parameter propertyName="pdfDriverVersion"/>
	<Parameter propertyName="pdfMomVersion"/>
	<Parameter propertyName="pdfDescr"/>
	<Parameter propertyName="pdfCodProdottoPrit"/>
	<Parameter propertyName="pdfCodOperazionePrit"/>
	<Parameter propertyName="pdfIsStampaEnabled"/>
	<Parameter propertyName="pdfIsCartaLiberaEnabled"/>
	<Parameter propertyName="pdfIsCartaChimicaEnabled"/>
	<Parameter propertyName="pdfIsFirmaDigitaleEnabled"/>
	<Parameter propertyName="pdfIsCopernicoEnabled"/>
	<Parameter propertyName="pdfNumCopie"/>
	<Parameter propertyName="pdfTestoCopia1"/>
	<Parameter propertyName="pdfTestoCopia2"/>
	<Parameter propertyName="pdfTestoCopia3"/>
	<Parameter propertyName="pdfTestoCopia4"/>
	<Parameter propertyName="pdfNumPages"/>
