<Access name="isContoScudato" type="DAOQueryAccess" queryType="0" maxResultRows="1"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType" connectionCacheReference="SER_MIFID"> 
	<Query> 
		select case when CONTR_C_CAT = '0099' then 'S' else 'N' end	 
		from CLL.CONTR 
		where contr_n like '001/'|| ? || '/%'
		and prod_c = 'BAN01'
	</Query>     
    <Input> 
    	<Parameter propertyName="numeroConto"/> 
	</Input> 
</Access> 

