<Access name="loadStatoFB" type="DAOQueryAccess" queryType="0" maxResultRows="1" connectionCacheReference="ARC">
	<Query>
		SELECT 	s.COD_STATO_SOGG
		, 		sg.COD_STATO_GIURID
 		FROM ARC_STRUTTURA_RETE r
		INNER JOIN ARC_STATO_SOGGETTO s ON s.N_STATO_SOGG = r.N_STATO_SOGG
		INNER JOIN ARC_ANAG_SOGGETTO aas ON aas.N_ANAG_SOGG = r.N_ANAG_SOGG
		INNER JOIN ARC_STATO_GIURIDICO sg ON sg.N_STATO_GIURID = r.N_STATO_GIURID
		WHERE r.FLG_ANNULLATO = 'N'
		AND s.FLG_ANNULLATO = 'N'
		AND sg.FLG_ANNULLATO = 'N'
		AND	r.COD_TIPO_STRUTT IN (0,1)
		AND aas.COD_SOGGETTO = ?
	</Query>
	<Input>
		<Parameter propertyName="codiceAgente"/>
	</Input>
	<Output>
		<Parameter propertyName="codStato"/>
		<Parameter propertyName="codStatoGiuridico"/>
	</Output>
</Access>

<Access name="loadDataValiditaMandatoFB" type="DAOQueryAccess" queryType="0" connectionCacheReference="ARC"
		OutputCommandDataModel="com.atosorigin.wfem.types.DateType">
	<Query>
		select min(DT_DECORR_MOV) IniMand
		  from ARC_ANAG_SOGGETTO aas
			   inner join ARC_MOV_STRUTTURA ams on ams.N_ANAG_SOGG = aas.N_ANAG_SOGG
			   inner join ARC_STATO_GIURIDICO asg on asg.N_STATO_GIURID = ams.N_STATO_GIURID
		 where aas.COD_SOGGETTO = ? 
		   and asg.COD_STATO_GIURID = ?
		   and aas.FLG_ANNULLATO = 'N'
	  group by aas.COD_SOGGETTO	
	</Query>
	<Input>
		<Parameter propertyName="codiceAgente"/>
		<Parameter propertyName="codStatoGiuridico"/>	
	</Input>
</Access>

<Access name="loadBloccoCliente" type="DAOQueryAccess" queryType="0" maxResultRows="1"
		OutputCommandDataModel="com.atosorigin.wfem.types.StringType" connectionCacheReference="DBAZ_SOGG">
	<Query>
		select 'DECEDUTO' as bloccoCliente
 		from 	CLL.CLI c
    	inner join CLL.CLI_EXT e on c.CLI_C = e.CLI_C
		where 	c.CLI_C = ?
		and		(c.CLI_C_COD_BLOCCO = '9' or c.CLI_S_BLOCCO_BAN = 'D' or e.COD_STATUS2 ='D')
    	union
 		select 	'REVOCATO' as bloccoCliente
 		from 	CLL.CLI c
		where 	c.CLI_C = ?
		and		(c.CLI_C_COD_BLOCCO = 'R' or c.CLI_S_BLOCCO_BAN = 'K')
	</Query>
	<Input>
		<Parameter propertyName="ndg"/>
		<Parameter propertyName="ndg"/>
	</Input>
</Access>

