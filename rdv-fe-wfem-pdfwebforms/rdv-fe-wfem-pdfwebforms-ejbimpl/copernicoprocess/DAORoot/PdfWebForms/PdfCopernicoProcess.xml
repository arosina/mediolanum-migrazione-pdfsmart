<Access name="verificaProprietaPdf" type="DAOQueryAccess" queryType="1"
		OutputCommandDataModel="com.atosorigin.wfem.types.BooleanType">
 <Query>
	select 	case when count(*) > 0 then 'S' else 'N' end
	from 	PDF_INSTANCE 
	where 	PDF_INSTANCE_ID = <p>chiave</p>
	and 	CLI1_NDG =  lpad(<p>contextUserCode</p>, 11, '0')
 </Query> 
</Access> 

