<DAO-Object name="PdfCopernicoProcess" connectionCacheReference="CEPE">

<Access name="loadIdDispoBasketDaAccettare" type="DAOQueryAccess" queryType="0"
		OutputCommandDataModel="prgm.pdfwebforms.model.PdfDataModel">
	<Query>
		select 	PDF_INSTANCE_ID
		from 	PDF_INSTANCE
		where 	ID_CARRELLO = ?
		and		STATO = '02'
		and		IN_BASKET = 'S'
		order by ORDINE_COMPILAZIONE_BASKET asc	
	</Query>     
	<Input>
		<Parameter propertyName="idCarrello"/>
	</Input>
	<Output>
		<Parameter propertyName="pdfInstanceId"/>
	</Output>
</Access>

