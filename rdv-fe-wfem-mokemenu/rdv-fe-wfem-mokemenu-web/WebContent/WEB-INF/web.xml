<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" id="WebApp_ID" version="2.5">
  <display-name>MokeMenuWEB</display-name>
  <welcome-file-list>
    <welcome-file>Pilota.jsp</welcome-file>
  </welcome-file-list>

	<servlet>
	    <servlet-name>WfemControllerServlet</servlet-name>
	    
	    <servlet-class>moke.menu2.business.NuovaServlet</servlet-class>
	    <init-param>
		    <param-name>USER_CONTEXT_FACTORY_CLASS_NAME</param-name>
		    <param-value>moke.menu2.login.UserContextFactory</param-value>
	    </init-param>
	    <init-param>
		    <param-name>LOGIN_MANAGER_CLASS_NAME</param-name>
		    <param-value>moke.menu2.login.LoginManagerImpl</param-value>
	    </init-param>
	    <init-param>
		    <param-name>FIRST_DISPLAY_COMMAND_CLASS_NAME</param-name>
		    <param-value>moke.menu2.display.MenuLoader</param-value>
	    </init-param>
	    
	    <load-on-startup>-1</load-on-startup>
	</servlet>
	
	<servlet-mapping>
	    <servlet-name>WfemControllerServlet</servlet-name>
	    <url-pattern>*.wfem</url-pattern>
	</servlet-mapping>

	<session-config>
		<session-timeout>20</session-timeout>
	</session-config>

	<listener>
		<listener-class>com.atosorigin.wfem.controller.SubsessionsInvalidator</listener-class>
	</listener>

</web-app>