<?xml version="1.0" encoding="UTF-8"?>

<DAO-Object name="Firme" connectionCacheReference="IQ_PRIT">

<Access name="loadContiCorrentiCliente" type="DAOQueryAccess" queryType="0" 
		OutputCommandDataModel="prgm.ita.p.dac.model.ContoCorrenteModel" connectionCacheReference="SER_MIFID">
 <Query>
	SELECT LRTPC.COD_RUOLO_CONTR_CLI, SUBSTR(CONTR.CONTR_N,5,8) AS CONTR, CASE WHEN FLG_CONTR_APER = 'C' THEN 1 ELSE 0 END AS IS_CHIUSO
		FROM SOGG_POSIZINFORM.DETT_CONTR_BANCA CONTR
		INNER JOIN CLL.CONTRCLI CONTRCLI ON CONTRCLI.PROD_C = CONTR.PROD_C AND CONTRCLI.CONTR_N = CONTR.CONTR_N
		INNER JOIN CAT_PROD.DETT_PROD_TECN DPT ON DPT.PROD_C = CONTR.PROD_C
		INNER JOIN SOGG_POSIZINFORM.DOM_STATO_CONTR DSCMP ON CAST(DSCMP.COD_STATO_CONTR AS CHAR(3)) = CONTR.COD_STATO_CONTR_EFFETV AND DSCMP.COD_TIPO_PROD_CONTR = DPT.COD_TIPO_PROD_CONTR
		INNER JOIN SOGG_POSIZINFORM.LEGM_RUOLO_TIPO_PROD_CONTR LRTPC ON LRTPC.COD_TIPO_PROD_CONTR = DPT.COD_TIPO_PROD_CONTR AND LRTPC.COD_RUOLO_CONTR_CLI = CONTRCLI.CONTRCLI_C_RUOLO_CONTR
		WHERE 1 = 1
		AND CONTRCLI.CLI_C = ?
		AND DPT.COD_TIPO_PROD_CONTR IN ('CC')
		AND CONTR.GSTD_F_ESIST = 'S'
		AND CONTRCLI.GSTD_F_ESIST = 'S'
		AND DSCMP.GSTD_F_ESIST = 'S'
		AND DPT.GSTD_F_ESIST = 'S'
 </Query>
 <Input>
	<Parameter propertyName="codMediolanum"/>
 </Input>
 <Output>
	<Parameter propertyName="ruoloSulConto"/>
	<Parameter propertyName="numeroConto"/>
	<Parameter propertyName="isChiuso"/>
 </Output> 
</Access>

