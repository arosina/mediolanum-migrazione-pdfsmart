<Access name="loadIsin" type="DAOQueryAccess" queryType="1" connectionCacheReference="SER_MIFID" OutputCommandDataModel="com.atosorigin.wfem.command.MapCommandDataModel">
	<Query> 
		SELECT CODICE_PRODOTTO, ISIN FROM SER_MIFID.CATALOGO_PRODOTTI_MIFID 
		WHERE CODICE_PRODOTTO IN (<ToString>listaCodiciProdotto</ToString>) 
		<IfNotNull propertyName="formaContrattuale">
			AND FORMA_CONTRATTUALE = <p>formaContrattuale</p>
		</IfNotNull>
		AND TIP_PROD = 'FO'		
	</Query>  
	<Output>
		<Parameter propertyName="codiceProdotto"/>
		<Parameter propertyName="isin"/>		
		<Parameter propertyName="formaContrattuale"/>
	</Output>	 
</Access>
</DAO-Object>