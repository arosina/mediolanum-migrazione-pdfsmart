<Access name="loadHaBancaDiretta" type="DAOQueryAccess" queryType="0">
	<Query>
		SELECT		case 
						when (count(*) > 0) then 'S'
						else 'N'
					end 
		FROM	    CLL.CONTR     CP
		,			CLL.CONTRCLI  LCC
		,           CLL.TABDECOD_RETE TR
		WHERE		CP.PROD_C = LCC.PROD_C
		AND			CP.CONTR_N = LCC.CONTR_N
		AND			LCC.CONTRCLI_C_RUOLO_CONTR IN ('I','P','C')
		AND         CP.PROD_C = 'BAN01'
		AND         CP.CONTR_C_CAT = TR.COD_DOM
		AND         TR.COD_TIPO_DOM = 'CATEGORIA_CC'
		AND 	    LCC.CLI_C = ?
	</Query>
	<Input>
		<Parameter propertyName="codMediolanum"/>
	</Input>	
	<Output>
		<Parameter propertyName="haBancaDiretta"/>
	</Output>	
</Access>

