<?xml version="1.0" encoding="UTF-8"?>

<DAO-Object name="VariazioneAnagraficaClienteLauncher" connectionCacheReference="DBAZ_SOGG">

<Access name="loadDatiCliente" type="DAOQueryAccess" queryType="0" 
		OutputCommandDataModel="com.atosorigin.wfem.command.MapCommandDataModel">
	<Query>
		select	CLI_C, CLI_F_SESSO, CLI_C_NATURA_GIURIDICA, CLI_X_CF, AGE_C_AGE 
		from	CLL.V_CLI 
		where	CLI_C = ?
		and		rownum = 1
	</Query>
	<Input>
		<Parameter propertyName="codMediolanum"/>
	</Input>	
	<Output>
		<Parameter propertyName="codMediolanum"/>
		<Parameter propertyName="sesso"/>
		<Parameter propertyName="naturaGiuridica"/>
		<Parameter propertyName="codiceFiscale"/>
		<Parameter propertyName="codAgenteAssegnatario"/>
	</Output>	
</Access>

<Access name="loadIsClienteAgente" type="DAOQueryAccess" queryType="0" connectionCacheReference="INR">
	<Query>
		select	case when count(*) > 0 then 'S' else 'N' end isClienteAgente
		from	INR_AGENTI
		where	AGE_X_CICLO_VITA = 'ATTIVO'
		and		(AGE_X_CF_AGE = ? or CODIFCLIMEDL_C_CLI_MEDL = (select right('00000000000' + ?, 11)))
	</Query>
	<Input> 
		<Parameter propertyName="codiceFiscale"/>
		<Parameter propertyName="codMediolanum"/>
    </Input> 
	<Output>
		<Parameter propertyName="isClienteAgente"/>
	</Output>
</Access>

<Access name="loadNdgAgente" type="DAOQueryAccess" queryType="0" 
        connectionCacheReference="INR" maxResultRows="1">
	<Query>
		select 	CODIFCLIMEDL_C_CLI_MEDL
		from 	INR_AGENTI
		where 	AGE_C_AGE = (select right('0000000000' + ?, 10)) 
	</Query>
	<Input>
		<Parameter propertyName="codAgente"/>
	</Input>
	<Output>
		<Parameter propertyName="codMediolanum"/>
	</Output>
</Access>
  
