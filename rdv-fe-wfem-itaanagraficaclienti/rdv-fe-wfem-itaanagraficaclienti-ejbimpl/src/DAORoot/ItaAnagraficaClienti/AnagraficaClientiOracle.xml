<Access name="recuperaDifferenziali" type="DAOQueryAccess" queryType="1" 
	OutputCommandDataModel="prgm.ita.anagraficaclienti.model.DifferenzialeClienteModel">
	<Query>
		select  COD_DIFFZL,
        		VAL_DIFFZL,
        		FLG_DIFFZL_LEVA
		from PROCCRM_MOTRDECIS.VW_DETT_DIFFZL_MOSER_ATTIV_CLI
		where to_char(CLI_C)=<p>codMediolanum</p>
	</Query>
	<Output>
		<Parameter propertyName="codiceDifferenziale"/>
		<Parameter propertyName="valoreDifferenziale"/>
		<Parameter propertyName="flagLeva"/>
	</Output>
</Access>

