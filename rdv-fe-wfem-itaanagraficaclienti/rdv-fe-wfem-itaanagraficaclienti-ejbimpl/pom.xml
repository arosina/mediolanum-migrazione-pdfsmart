<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>prgm.ita.anagraficaclienti</groupId>
    <artifactId>rdv-fe-wfem-itaanagraficaclienti</artifactId>
    <version>15.2.0</version>
  </parent>
  <artifactId>rdv-fe-wfem-itaanagraficaclienti-ejbimpl</artifactId>
  <name>ItaAnagraficaClienti</name>
  <properties>   
    <sonar.sources>${project.basedir}/src,${project.basedir}/questionari</sonar.sources>
    <sonar.tests>${project.basedir}/test</sonar.tests>
  </properties>  
  <dependencies>
    <dependency>
      <groupId>com.atosorigin.wfem</groupId>
      <artifactId>rdv-be-wfem-framework-ejbimpl</artifactId>
      <version>${dep.rdv-be-wfem-framework-ejbimpl.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>prgm.itap.dac</groupId>
      <artifactId>rdv-fe-wfem-itapdac-ejbimpl</artifactId>
      <version>${dep.rdv-fe-wfem-itapdac-ejbimpl.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>prgm.cedacri.adeguatezza</groupId>
      <artifactId>rdv-be-wfem-adeguatezzacedacri-ejbimpl</artifactId>
      <version>${dep.rdv-be-wfem-adeguatezzacedacri-ejbimpl.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/questionari</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/stampamoduli</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/agenticlienti</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/copernico</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src</source>
                <source>${project.basedir}/questionari</source>
                <source>${project.basedir}/stampamoduli</source>
                <source>${project.basedir}/agenticlienti</source>
                <source>${project.basedir}/copernico</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/test</source>                
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <phase>prepare-package</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
         <groupId>org.jacoco</groupId>
         <artifactId>jacoco-maven-plugin</artifactId>
      </plugin> 
       <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>truezip-maven-plugin</artifactId>
      </plugin>    
        </plugins>
      </build>
   
</project>